# ===== LLM (OpenAI-compatible) =====
# Leave LLM_API_KEY empty to run in instant Demo / MOCK mode (zero API spend).
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# ===== Supabase (Optional Cloud Deal Room) =====
# Leave empty to use the built-in Local Deal Vault (data/outputs/deal_room/).
SUPABASE_URL=
SUPABASE_KEY=

# ===== App Behavior =====
MAX_PAGES_PER_PDF=200
MAX_CHARS_TO_LLM=140000
