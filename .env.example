# ===== LLM (OpenAI-compatible) =====
# Leave LLM_API_KEY empty to run the app in MOCK mode (no API spend, demoable instantly).
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o

# ===== Supabase =====
# Optional. Leave empty to skip persistence (reports still save to disk + download).
SUPABASE_URL=
SUPABASE_KEY=

# ===== App behavior =====
MAX_PAGES_PER_PDF=200
MAX_CHARS_TO_LLM=120000
